# OTTv2 Arena API — Backend Environment Variables
# Copy file này thành .env và điền giá trị thực trước khi chạy.
# CẢNH BÁO: Không commit file .env vào git.

# ── Redis (Upstash) ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Optional isolation for a separate stack on the same Redis database.
REDIS_KEY_PREFIX=

# ── Secrets (BẮT BUỘC — server từ chối khởi động nếu còn là giá trị mẫu) ──────

# Worker → Backend auth: worker gửi header X-Worker-Secret
# Phải khớp với WORKER_SECRET trong worker/.env
WORKER_SECRET=replace-with-a-random-secret-32-chars-minimum

# Next.js server → Backend auth: frontend gửi header X-Internal-Secret khi enqueue
# Phải khớp với INTERNAL_BACKEND_SECRET trong Frontend/.env.local
INTERNAL_BACKEND_SECRET=replace-with-another-random-secret-32-chars

# ── App settings ──────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["https://your-frontend.vercel.app"]
MAX_MOVES_PER_MATCH=200
JOB_TTL_SECONDS=3600
MATCH_TTL_SECONDS=86400
