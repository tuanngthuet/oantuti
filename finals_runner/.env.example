# OTTv2 Arena — Finals Runner Environment Variables
# Finals Runner hoạt động độc lập qua PostgreSQL (không dùng Redis).
# CẢNH BÁO: Không commit file .env vào git.

# ─── Database (Neon / PostgreSQL) ─────────────────────────────────────────────
FINALS_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Schema dùng riêng cho vòng Chung kết (phải bắt đầu bằng "finals", mặc định: finals)
FINALS_SCHEMA=finals

# Optional: IPv4/IPv6 trực tiếp để tránh lỗi phân giải DNS mỗi lần kết nối
# FINALS_DB_HOSTADDR=

# ─── Worker Identity ──────────────────────────────────────────────────────────
FINALS_WORKER_ID=finals-local

# ─── Judge0 (Dedicated / Local) ───────────────────────────────────────────────
FINALS_JUDGE0_URL=http://localhost:2358
FINALS_JUDGE0_API_KEY=
FINALS_JUDGE0_LANGUAGE_ID=71
