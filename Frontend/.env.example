# OTTv2 Arena — Frontend (Next.js) Environment Variables
# Copy file này thành .env.local và điền giá trị thực.
# CẢNH BÁO: Không commit file .env.local vào git.

# ── Database (Neon Postgres) ───────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require"
# Optional: isolate a separate stack in an existing PostgreSQL schema.
# DATABASE_SCHEMA=ott_e2e_example

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT session secret — ít nhất 32 ký tự ngẫu nhiên
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# ── Backend URL ───────────────────────────────────────────────────────────────
# URL của FastAPI backend (Vercel hoặc localhost khi dev)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ── Secrets (BẮT BUỘC) ───────────────────────────────────────────────────────

# Next.js server → Backend: gửi qua header X-Internal-Secret khi enqueue task
# Phải khớp với INTERNAL_BACKEND_SECRET trong backend/.env
INTERNAL_BACKEND_SECRET=replace-with-another-random-secret-32-chars

# Worker → Next.js: worker gửi header X-Worker-Callback-Secret khi callback và dispatch
# Phải khớp với WORKER_CALLBACK_SECRET trong worker/.env
WORKER_CALLBACK_SECRET=replace-with-yet-another-random-secret-32-chars

# ── Optional ──────────────────────────────────────────────────────────────────
# URL public của frontend (dùng cho rating scheduler nếu cần)
# NEXT_PUBLIC_FRONTEND_URL=https://your-frontend.vercel.app
# Optional isolated finals schema, same Neon connection. Runner uses its own env.
FINALS_SCHEMA=finals

# Chung kết: tạo 5 token riêng bằng worker_ck/configure.py.
# Chép giá trị CK_WORKER_TOKENS từ worker_ck/.env.frontend vào môi trường frontend.
# Worker rating không dùng biến này.
CK_WORKER_TOKENS=
