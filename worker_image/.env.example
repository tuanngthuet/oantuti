# Use the SAME backend, frontend and authentication as the Judge0 worker.
# localhost inside the container is not the host. This alias is defined in compose.yaml.
BACKEND_URL=http://host.docker.internal:8000
FRONTEND_URL=http://host.docker.internal:3000
WORKER_SECRET=replace-with-your-backend-worker-secret
WORKER_CALLBACK_SECRET=replace-with-your-frontend-callback-secret

# Use a different name from the Judge0 worker running on the same machine.
WORKER_ID=local-python
# Optional stable identity override; set this on hosts without /etc/machine-id.
# MACHINE_ID=my-stable-host-id

# Initial registration only; subsequent concurrency is controlled by /admin/workers.
MAX_CONCURRENT=4
POLL_INTERVAL=1

# Limits PER AGENT TURN, not per match. CPU is CPU seconds; wall is elapsed seconds.
AGENT_CPU_SECONDS=10
AGENT_WALL_SECONDS=12
# MiB of virtual address space (RLIMIT_AS), not RSS.
AGENT_MEMORY_MB=128
# Combined stdout + stderr, bytes.
AGENT_OUTPUT_BYTES=65536
AGENT_SOURCE_BYTES=1048576
