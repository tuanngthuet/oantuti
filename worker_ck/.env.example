# One file per worker (.env.round_16, .env.quarterfinal, ...).
CK_FRONTEND_URL=http://host.docker.internal:3000
CK_WORKER_ID=ck-round-16-01
CK_WORKER_TOKEN=replace-with-unique-token-at-least-32-characters
# Limits are included in the engine identity; keep fixed after opening submissions.
CK_AGENT_CPU_SECONDS=2
CK_AGENT_WALL_SECONDS=4
CK_AGENT_MEMORY_MB=128
